{
    "manifest_version": 2,
    "name": "Démo application Native Messaging - Onglet actif",
    "version": "1.0",
    "description": "Envoi l'URL de l'onglet actif à l'app native.",
    "permissions": [
        "nativeMessaging",
        "tabs",
        "activeTab"
    ],
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "browser_action": {
        "default_title": "Envoi l'onglet actif"
    },
    "applications": {
        "gecko": {
            "id": "native-demo@example.com"
        }
    }
}
