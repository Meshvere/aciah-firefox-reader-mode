{
    "manifest_version": 2,
    "name": "Aciah - Force mode lecture",
    "version": "1.0",
    "description": "Active automatiquement le mode lecture sur les pages compatibles.",
    "permissions": [
        "tabs",
        "<all_urls>"
    ],
    "background": {
        "scripts": ["background.js"],
        "persistent": true
    },
    "browser_action": {
        "default_title": "Aciah - Force mode lecture"
    }
}
